# =============================================================================
# NAVAM — Environment Variables Example
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# In production, secrets are injected by HashiCorp Vault.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Core Application
# ─────────────────────────────────────────────────────────────────────────────

# Environment name: development | staging | production | demo
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# Enable demo mode — serves synthetic data, disables Kafka consumers
# Set to true for SIH presentation / offline demo
DEMO_MODE=false

# ─────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL + PostGIS)
# ─────────────────────────────────────────────────────────────────────────────

# Async SQLAlchemy URL (FastAPI / asyncpg)
DATABASE_URL=postgresql+asyncpg://navam:navam_dev_secret@localhost:5432/navam

# Sync SQLAlchemy URL (Alembic migrations)
DATABASE_URL_SYNC=postgresql+psycopg2://navam:navam_dev_secret@localhost:5432/navam

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────

# Redis connection URL
# DB 0: general cache  |  DB 1: session store  |  DB 2: rate limiter
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# Keycloak — Identity & Access Management
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Keycloak server (no trailing slash)
KEYCLOAK_URL=http://localhost:8080

# Realm name configured in Keycloak admin
KEYCLOAK_REALM=navam

# Client ID registered in the Keycloak realm
KEYCLOAK_CLIENT_ID=navam-api

# Client secret — retrieve from Keycloak admin console → Clients → Credentials
# In production: stored in Vault at secret/navam/keycloak#client_secret
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# ─────────────────────────────────────────────────────────────────────────────
# ML Serving
# ─────────────────────────────────────────────────────────────────────────────

# Internal URL to the ML inference microservice
ML_SERVING_URL=http://localhost:8001

# MLflow tracking server URL
MLFLOW_TRACKING_URI=http://localhost:5001

# ─────────────────────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────────────────────

# JWT signing secret — minimum 32 characters, random
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-signing-key-minimum-32-chars-change-this

# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─────────────────────────────────────────────────────────────────────────────
# Martin Tile Server
# ─────────────────────────────────────────────────────────────────────────────

# URL exposed to the frontend for MVT tile requests
MARTIN_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Kafka
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated list of Kafka broker addresses
# Dev: localhost:29092 (external listener)  |  K8s: kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Consumer group ID for the worker service
KAFKA_GROUP_ID=navam-worker

# Schema Registry URL
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# ─────────────────────────────────────────────────────────────────────────────
# Apache Airflow
# ─────────────────────────────────────────────────────────────────────────────

# Fernet key for encrypting connections and variables
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here-generate-with-command-above

# ─────────────────────────────────────────────────────────────────────────────
# AWS
# ─────────────────────────────────────────────────────────────────────────────

# AWS region (MeitY-empanelled: ap-south-1 Mumbai)
AWS_REGION=ap-south-1

# S3 bucket for MLflow artifacts (staging/production)
AWS_S3_BUCKET=navam-mlflow-artifacts-development

# ─────────────────────────────────────────────────────────────────────────────
# Observability — Sentry (optional)
# ─────────────────────────────────────────────────────────────────────────────

# Leave empty to disable Sentry error tracking
# Format: https://<key>@sentry.io/<project-id>
SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# External Data APIs
# ─────────────────────────────────────────────────────────────────────────────

# NDEM (National Disaster Management) API
# Used to fetch live weather, flood, and earthquake bulletins
NDEM_API_URL=https://api.ndma.gov.in/v1
NDEM_API_KEY=your-ndem-api-key-here

# IMD (India Meteorological Department) data feed
IMD_API_URL=https://mausam.imd.gov.in/api
IMD_API_KEY=your-imd-api-key-here

# CWC (Central Water Commission) real-time flood data
CWC_API_URL=https://cwc.gov.in/flood/api
CWC_API_KEY=your-cwc-api-key-here

# GSI (Geological Survey of India) landslide inventory
GSI_API_URL=https://gsi.gov.in/api
GSI_API_KEY=your-gsi-api-key-here

# ─────────────────────────────────────────────────────────────────────────────
# LGD (Local Government Directory)
# ─────────────────────────────────────────────────────────────────────────────

# LGD API for habitation codes and administrative hierarchy
LGD_API_URL=https://lgdirectory.gov.in/api/v1
LGD_API_KEY=your-lgd-api-key-here

# ─────────────────────────────────────────────────────────────────────────────
# Feature Flags (override defaults at runtime)
# ─────────────────────────────────────────────────────────────────────────────

# Enable real-time Kafka ingestion (disable if no Kafka available)
FEATURE_KAFKA_INGESTION=true

# Enable ML-based route optimisation (disable to fall back to heuristics)
FEATURE_ML_ROUTING=true

# Enable geospatial conflict detection
FEATURE_CONFLICT_DETECTION=true
